{
  "global": {
    "files": "/src/**/*.*"
  },
  "dependencies": [
    {
      // the abap2UI5 framework this app runs on - cloned by abaplint for
      // dependency resolution (z2ui5_if_app, z2ui5_if_client, z2ui5_cl_ui5_view_builder)
      "url": "https://github.com/abap2UI5/abap2UI5",
      // Match the minimum framework release in README.md. "branch" accepts
      // release tags; after changing it, run npm run check.
      "branch": "1.146.0",
      "files": "/src/**/*.*"
    },
    {
      // the abapGit developer version this app calls (ZCL_ABAPGIT_*, ZIF_ABAPGIT_*)
      "url": "https://github.com/abapGit/abapGit",
      "branch": "main",
      // deps/ holds abapGit's own stubs of SAP objects it needs to resolve
      "files": "/{src,deps}/**/*.*"
    },
    {
      // SAP standard stubs (CX_STATIC_CHECK, IF_T100_MESSAGE ...) that
      // abapGit's classes build on
      "url": "https://github.com/abaplint/deps",
      "files": "/src/**/*.*"
    }
  ],
  "syntax": {
    "version": "v750",
    // own namespace fully checked; unknown SAP-standard objects are void so
    // the lint does not depend on a full standard-API mirror
    "errorNamespace": "^(Z|Y)"
  },
  "rules": {
    "begin_end_names": true,
    "check_ddic": true,
    "check_include": true,
    "check_syntax": true,
    "global_class": true,
    "implement_methods": true,
    "method_implemented_twice": true,
    "parser_error": true,
    "superclass_final": true,
    "unknown_types": true,
    "allowed_object_types": {
      "allowed": ["CLAS", "DEVC", "FUGR", "INTF", "PROG", "SICF", "TABL", "TRAN"]
    },
    "obsolete_statement": true,

    // Check correctness, ABAP compatibility, SQL and serialization without
    // imposing optional formatting preferences.

    // Correctness - a defect, not a preference
    "ambiguous_statement": true,
    "catch_and_raise": true,
    "check_abstract": true,
    "check_subrc": true,
    "classic_exceptions_overlap": true,
    "cyclic_oo": true,
    "dangerous_statement": true,
    "empty_statement": true,
    "identical_conditions": true,
    "identical_contents": true,
    "identical_descriptions": true,
    "identical_move": true,
    "index_completely_contained": true,
    "invalid_table_index": true,
    "method_overwrites_builtin": true,
    "no_chained_assignment": true,
    "parser_bad_exceptions": true,
    "parser_missing_space": true,
    "sy_modification": true,
    "try_without_catch": true,
    "uncaught_exception": true,
    "unnecessary_return": true,
    "unreachable_code": true,
    "use_class_based_exceptions": true,
    "when_others_last": true,

    // Compatibility with the configured ABAP 7.50 target
    "cloud_types": true,
    "downport": true,
    "forbidden_void_type": true,
    "fully_type_constants": true,
    "fully_type_itabs": true,
    "inline_data_old_versions": true,
    "parser_702_chaining": true,

    // SQL - correctness and performance of what reaches the database
    "db_operation_in_loop": true,
    "modify_only_own_db_tables": true,
    "select_add_order_by": true,
    "select_performance": true,
    "select_single_full_key": true,
    "sql_escape_host_variables": true,
    "sql_value_conversion": true,
    "strict_sql": true,
    "unsecure_fae": true,

    // Dead weight - shipped, serialized, read by nobody
    "empty_event": true,
    "empty_structure": true,
    "superfluous_value": true,
    "unnecessary_chaining": true,
    "unnecessary_pragma": true,
    "unused_ddic": true,
    "unused_methods": true,
    "unused_types": true,
    "unused_variables": true,

    // The abapGit round trip - the file has to come back byte-identical
    "colon_missing_space": true,
    "contains_tab": true,
    "description_empty": true,
    "line_break_style": true,
    "local_testclass_consistency": true,
    "main_file_contents": true,
    // Keep class names in XML sidecars consistent with their filenames.
    "xml_consistency": true,
    // Preserve abapGit's UTF-8 BOM in XML sidecars to avoid round-trip changes.
    "xml_bom": true,
    // Trailing spaces disappear when saved in the ABAP editor.
    "whitespace_end": true,
    "definitions_top": false,
    "7bit_ascii": true,
    "line_length": {
      "length": 255
    },
    "object_naming": {
      "patternKind": "required",
      "clas": "^ZCL_|^ZCX_",
      "intf": "^ZIF_"
    }
  }
}
