{
  "name": "abapgit2ui5",
  "private": true,
  "version": "0.1.0",
  "description": "abapGit frontend built with abap2UI5 - the checks that run without an SAP system.",
  "scripts": {
    "check": "npm run check:abap && npm run check:abap2ui5",
    "check:abap": "abaplint abaplint.jsonc",
    "check:abap2ui5": "abap2ui5lint",
    "check:abap2ui5:fast": "abap2ui5lint --no-render",
    "fix": "abap2ui5lint --fix",
    "test": "npm run check"
  },
  "license": "MIT",
  "devDependencies": {
    "@abap2ui5/linter": "^0.8.3",
    "@abap2ui5/linter-render": "^0.8.3",
    "@abaplint/cli": "^2.120.60"
  }
}
