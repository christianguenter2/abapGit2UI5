{
  // Full configuration reference: https://github.com/abap2UI5/linter
  // Use the installed version's schema for editor validation.
  "$schema": "./node_modules/@abap2ui5/linter/data/abap2ui5lint.schema.json",

  "paths": ["src"],

  // Check controls and properties against the supported SAPUI5 floor.
  "ui5": "1.71",
  "distribution": "sapui5",

  // Require the headless render gate in CI and npm run check. During editing,
  // npm run check:abap2ui5:fast skips rendering.
  "render": true,

  "rules": {
    // Keep builder chains readable; npm run fix applies this layout.
    "chain-house-layout": { "severity": "warning" }
  },

  "failOn": "warning"
}
